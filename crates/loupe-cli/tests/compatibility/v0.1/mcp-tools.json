            "minLength": 1
          },
          "take": {
            "type": "integer",
            "minimum": 1
          },
          "candidates": {
            "type": "string",
            "enum": [
              "dates",
              "money",
              "semver",
              "emails",
              "hostnames",
              "tickers"
            ]
          },
          "normalize": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
