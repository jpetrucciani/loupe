    {
      "name": "extract",
      "description": "Select source-backed parsed spans and byte offsets, with optional deterministic normalization.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string"
          },
          "path": {
            "type": "string",
