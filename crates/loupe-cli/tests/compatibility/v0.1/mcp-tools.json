                "type": "string"
              },
              "tz": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "decimal_separator": {
                "enum": [
                  "dot",
                  "comma"
                ]
              },
              "date_order": {
                "enum": [
                  "mdy",
                  "dmy"
                ]
              }
            }
          }
        },
        "required": [
          "query",
          "candidates"
        ],
